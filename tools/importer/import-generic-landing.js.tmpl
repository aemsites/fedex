/* eslint-disable */
/* global WebImporter */

// Generated by tools/importer/gen-generic-landing.py from page-templates.json - edit that, not this

// PARSER IMPORTS
__PARSER_IMPORTS__

// TRANSFORMER IMPORTS
import fedexCleanupTransformer from './transformers/fedex-cleanup.js';
import fedexLandingTransformer from './transformers/fedex-landing.js';
import fedexPreprocess from './fedex-preprocess.js';

// PARSER REGISTRY
const parsers = {
__PARSER_REGISTRY__
};

// PAGE TEMPLATE CONFIGURATION - embedded from tools/importer/page-templates.json
const PAGE_TEMPLATE = __TEMPLATE__;

// TRANSFORMER REGISTRY - cleanup first, then the generic landing rules (section breaks from the
// page grid, jump links, forms); no template sections, so fedex-sections.js is not used
const transformers = [
  fedexCleanupTransformer,
  fedexLandingTransformer,
];

/**
 * Execute all page transformers for a specific hook
 * @param {string} hookName - 'beforeTransform' or 'afterTransform'
 * @param {Element} element - The DOM element to transform
 * @param {Object} payload - { document, url, html, params }
 */
function executeTransformers(hookName, element, payload) {
  const enhancedPayload = { ...payload, template: PAGE_TEMPLATE };
  transformers.forEach((transformerFn) => {
    try {
      transformerFn.call(null, hookName, element, enhancedPayload);
    } catch (e) {
      console.error(`Transformer failed at ${hookName}:`, e);
    }
  });
}

// a component whose content (children with text or images) is all mobile-only
function mobileOnly(element) {
  const parts = [...element.children].filter((c) => c.textContent.trim() || c.querySelector('img'));
  return parts.length > 0 && parts.every((c) => c.matches('.fxg-desktop--hide'));
}

/**
 * Find all blocks on the page based on the embedded template configuration.
 * All elements are collected before any parser runs; an element matched by several blocks is
 * claimed by the first block in template order.
 * @param {Document} document - The DOM document
 * @param {Object} template - The embedded PAGE_TEMPLATE object
 * @returns {Array} Block instances found on the page
 */
function findBlocksOnPage(document, template) {
  const pageBlocks = [];
  const claimed = new Set();
  template.blocks.forEach((blockDef) => {
    blockDef.instances.forEach((selector) => {
      let elements = [];
      try {
        elements = [...document.querySelectorAll(selector)];
      } catch (e) {
        console.warn(`Block "${blockDef.name}" selector is invalid: ${selector}`);
      }
      elements.forEach((element) => {
        // mobile-only renditions (.fxg-desktop--hide) are never imported; fedex-cleanup removes
        // them after the parsers, too late for a block built from one (nl-nl/home: a
        // featured_offer_v2 whose only content is a mobile-only wrapper, "We maken logistiek
        // eenvoudig voor uw bedrijf")
        if (claimed.has(element) || element.closest('.fxg-desktop--hide') || mobileOnly(element)) return;
        claimed.add(element);
        pageBlocks.push({
          name: blockDef.name, selector, element, section: blockDef.section || null,
        });
      });
    });
  });
  // Parse in document order: run-merging parsers (cards-horizontal, columns, accordion) must start
  // at the first item of a run. In template order a later item matched by an earlier selector was
  // parsed first and split the run (dangerous-goods: nine class rows became five blocks).
  // Containers still precede their contents, so a nested match is detached before its turn.
  // Exception: an accordion inside another accordion goes first, because parsers/accordion.js turns
  // the outer one into a group heading once its inner run is parsed (temperature-controlled).
  pageBlocks.sort((a, b) => {
    if (a.name === 'accordion' && b.name === 'accordion') {
      if (a.element.contains(b.element)) return 1;
      if (b.element.contains(a.element)) return -1;
    }
    return a.element.compareDocumentPosition(b.element) & 4 ? -1 : 1;
  });
  console.log(`Found ${pageBlocks.length} block instances on page`);
  return pageBlocks;
}

// EU homepages (nl-nl/home) run an Optimizely A/B test on the hero: the test variant replaces the
// authored hero and shipping tools with script-rendered web components (homepage-a-hero,
// homepage-b-links). The authored control is imported (decision of 2026-10-13); assignment is
// random per fresh visitor and happens before the importer can act, so a page served as the test
// variant fails here and is re-run (the bulk runner reports it as failed).
function rejectHomepageTestVariant(document) {
  if (document.querySelector('homepage-a-hero, homepage-b-links')) {
    throw new Error('AB_TEST_VARIANT: fedex.com served the homepage test variant; re-run to get the authored control');
  }
}

export default {
  // Awaited by the bulk runner before the transform
  onLoad: async ({ document }) => rejectHomepageTestVariant(document),

  // Runs before helix-importer's own DOM preprocessing (which would drop text next to `u > a`)
  preprocess: fedexPreprocess,

  transform: (payload) => {
    const { document, url, params } = payload;
    const main = document.body;

    // 1. Initial cleanup, forms, section breaks, jump links
    executeTransformers('beforeTransform', main, payload);

    // 2. Find blocks using embedded template
    const pageBlocks = findBlocksOnPage(document, PAGE_TEMPLATE);

    // 3. Parse each block in document order per block type; skip elements an earlier parser
    //    already replaced or consumed (detached)
    pageBlocks.forEach((block) => {
      if (!block.element.isConnected) return;
      const parser = parsers[block.name];
      if (parser) {
        try {
          parser(block.element, { document, url, params });
        } catch (e) {
          console.error(`Failed to parse ${block.name} (${block.selector}):`, e);
        }
      } else {
        console.warn(`No parser found for block: ${block.name}`);
      }
    });

    // 4. Final cleanup
    executeTransformers('afterTransform', main, payload);

    // 5. WebImporter built-in rules
    const hr = document.createElement('hr');
    main.appendChild(hr);
    WebImporter.rules.createMetadata(main, document);
    WebImporter.rules.transformBackgroundImages(main, document);
    WebImporter.rules.adjustImageUrls(main, url, params.originalURL);

    // 6. Sanitized path
    const rawPath = new URL(params.originalURL).pathname
      .replace(/\/$/, '')
      .replace(/\.html?$/, '');
    const path = WebImporter.FileUtils.sanitizePath(rawPath === '' ? '/index' : rawPath);

    // Accordion answers holding a table become fragments (parsers/accordion.js). The bulk runner
    // saves one document per URL, so each fragment is imported as <page>.html?fragment=<index>.
    const fragments = document.importFragments || [];
    if (fragments.length) console.log(`IMPORT_FRAGMENTS ${rawPath} ${fragments.length}`);
    const fragmentIndex = new URL(params.originalURL).searchParams.get('fragment');
    if (fragmentIndex !== null) {
      const f = fragments[Number(fragmentIndex) || 0];
      if (!f) throw new Error(`No fragment ${fragmentIndex} on ${params.originalURL}`);
      return {
        element: f.element,
        path: WebImporter.FileUtils.sanitizePath(f.path),
        report: { title: f.title || f.path, template: `${PAGE_TEMPLATE.name}-fragment`, blocks: ['table'] },
      };
    }

    return {
      element: main,
      path,
      report: {
        title: document.title,
        template: PAGE_TEMPLATE.name,
        blocks: pageBlocks.map((b) => b.name),
      },
    };
  },
};
