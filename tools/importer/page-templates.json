{
  "metadata": {
    "projectType": "da"
  },
  "templates": [
    {
      "name": "home",
      "urls": [
        "https://www.fedex.com/en-us/home.html"
      ],
      "representativeUrl": "https://www.fedex.com/en-us/home.html",
